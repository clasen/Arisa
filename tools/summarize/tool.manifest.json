{
  "name": "summarize",
  "description": "Summarize URLs, YouTube videos, podcasts, and files via steipete/summarize.",
  "entry": "index.js",
  "input": ["text/plain"],
  "output": ["text/plain"],
  "configSchema": {
    "MODEL": {
      "type": "string",
      "required": false,
      "prompt": "Default model id for summarize, for example openrouter/openai/gpt-5-mini."
    },
    "OPENROUTER_API_KEY": {
      "type": "string",
      "required": false,
      "secret": true,
      "prompt": "Optional OPENROUTER_API_KEY for summarize."
    },
    "OPENAI_API_KEY": {
      "type": "string",
      "required": false,
      "secret": true,
      "prompt": "Optional OPENAI_API_KEY for summarize."
    },
    "ANTHROPIC_API_KEY": {
      "type": "string",
      "required": false,
      "secret": true,
      "prompt": "Optional ANTHROPIC_API_KEY for summarize."
    },
    "GOOGLE_API_KEY": {
      "type": "string",
      "required": false,
      "secret": true,
      "prompt": "Optional GOOGLE_API_KEY for summarize."
    },
    "GROQ_API_KEY": {
      "type": "string",
      "required": false,
      "secret": true,
      "prompt": "Optional GROQ_API_KEY for summarize transcription fallback."
    }
  }
}
