{
  "name": "openai-transcribe",
  "description": "Transcribe audio files and video audio tracks with OpenAI audio transcription API.",
  "entry": "index.js",
  "input": [
    "audio/aac",
    "audio/flac",
    "audio/m4a",
    "audio/mp3",
    "audio/mp4",
    "audio/mpeg",
    "audio/mpga",
    "audio/ogg",
    "audio/opus",
    "audio/wav",
    "audio/wave",
    "audio/webm",
    "audio/x-m4a",
    "audio/x-wav",
    "video/mp4",
    "video/webm"
  ],
  "output": [
    "text/plain"
  ],
  "configSchema": {
    "OPENAI_API_KEY": {
      "type": "string",
      "required": true,
      "secret": true,
      "prompt": "I need your OPENAI_API_KEY to transcribe audio."
    }
  },
  "category": "transcription",
  "keywords": [
    "audio",
    "essential",
    "normalization",
    "openai",
    "speech-to-text",
    "transcribe",
    "video"
  ]
}
