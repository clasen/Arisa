{
  "name": "audio-extractor",
  "description": "Extract and normalize audio from video or audio media with ffmpeg.",
  "entry": "index.js",
  "input": [
    "video/mp4",
    "video/webm",
    "video/quicktime",
    "audio/aac",
    "audio/flac",
    "audio/m4a",
    "audio/mp4",
    "audio/mpeg",
    "audio/ogg",
    "audio/opus",
    "audio/wav",
    "audio/webm",
    "audio/x-m4a",
    "audio/x-wav"
  ],
  "output": [
    "audio/wav",
    "audio/mpeg"
  ],
  "configSchema": {
    "FFMPEG_COMMAND": {
      "type": "string",
      "required": false,
      "prompt": "Optional ffmpeg command or absolute path. Defaults to ffmpeg."
    },
    "FFPROBE_COMMAND": {
      "type": "string",
      "required": false,
      "prompt": "Optional ffprobe command or absolute path. Defaults to ffprobe."
    }
  },
  "category": "media",
  "keywords": [
    "audio",
    "essential",
    "extract",
    "ffmpeg",
    "normalize",
    "preprocessing",
    "video"
  ]
}
